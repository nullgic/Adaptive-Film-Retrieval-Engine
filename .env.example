# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# This file is read twice: by scripts/db.py via load_dotenv, and by Docker via
# `env_file: .env` in docker-compose.yml. The POSTGRES_* names are the ones the
# postgres image itself expects, which is why they cannot be renamed freely.

POSTGRES_PASSWORD=changeme
POSTGRES_USER=filmsearch
POSTGRES_DB=filmsearch

# Read by scripts/db.py, which defaults to localhost:5432 if unset. The host is
# localhost rather than the container name because compose publishes the port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kaggle auth for scripts/download_data.py. Only ONE of these is needed:
# either KAGGLE_API_TOKEN, or the KAGGLE_USERNAME + KAGGLE_KEY pair.
KAGGLE_API_TOKEN=

KAGGLE_USERNAME=
KAGGLE_KEY=
